# FundamenTracker environment template.
# Copy this file to .env and fill in your own values. Do not commit .env.

# Shared backend settings
# Backend log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
# Development defaults to http://localhost:5173 when this is empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_WILDCARD_CORS=false

# API token authentication.
# Mutable endpoints and sensitive read endpoints require Authorization: Bearer <API_AUTH_TOKEN>.
# GET /watchlist also requires the token unless READONLY_PUBLIC=true.
# GET /health/live is always public. GET /health/ready requires the token unless PUBLIC_READY_HEALTH=true.
API_AUTH_TOKEN=change-me-api-token
READONLY_PUBLIC=false
PUBLIC_READY_HEALTH=false

# Persistence backend: postgres, sqlite, or supabase_rest.
# docker-compose.prod.yml defaults this to postgres when unset.
# A bare non-Compose API still defaults to supabase_rest when DATABASE_BACKEND is unset.
# DATABASE_BACKEND=postgres

# SQLite persistence. Intended for lightweight single-host deployments such as
# Raspberry Pi. The parent directory is created automatically when possible.
# DATABASE_BACKEND=sqlite
SQLITE_PATH=/srv/fundamentracker/fundamentracker.db

# Supabase REST persistence. Required only when DATABASE_BACKEND=supabase_rest.
# DATABASE_BACKEND=supabase_rest
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_KEY=example-supabase-key

# Local PostgreSQL persistence. Used by default in docker-compose.prod.yml.
# docker-compose.prod.yml derives DATABASE_URL from these values when DATABASE_URL is unset.
POSTGRES_DB=fundamentracker
POSTGRES_USER=fundamentracker
POSTGRES_PASSWORD=change-me-postgres-password
# Keep false for normal production startup. Run migrations manually with
# `make db-migrate`, or set true only when you intentionally want the API
# container to apply pending local PostgreSQL migrations before starting.
RUN_MIGRATIONS_ON_START=false
# DATABASE_URL must point to the Compose postgres service from inside the API container.
# Set it explicitly if you need URL-encoded credentials or a non-Compose database.
# DATABASE_URL=postgresql://fundamentracker:change-me-postgres-password@postgres:5432/fundamentracker

# Persistent market data cache TTLs, in seconds.
MARKET_DATA_TTL_PRICE_SECONDS=300
MARKET_DATA_TTL_QUOTE_SECONDS=300
MARKET_DATA_TTL_FUNDAMENTALS_SECONDS=86400
MARKET_DATA_TTL_STATEMENTS_SECONDS=604800

# Optional production database dashboard.
# pgAdmin is available through the docker-compose.prod.yml dashboard profile.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_BIND_IP=127.0.0.1

# Optional AI valuation.
GEMINI_API_KEY=

# Optional SEC EDGAR fundamentals provider.
# SEC asks clients to send a descriptive User-Agent with contact information.
# Use a non-secret project/contact value here; do not commit personal contact info.
SEC_USER_AGENT=FundamenTracker contact@example.com
SEC_RATE_LIMIT_SECONDS=0.2
SEC_TICKER_CACHE_PATH=

# Optional Telegram notifications and bot command polling.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Development compose settings
# Used by docker-compose.dev.yml.
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
# Vite embeds VITE_* values into public browser assets.
# VITE_API_AUTH_TOKEN is only suitable for trusted/private frontends, such as local dev,
# private LAN, Cloudflare Access, or VPN deployments. Do not rely on it as strong
# security for an unprotected internet-facing frontend.
VITE_API_AUTH_TOKEN=change-me-api-token

# Production compose settings
# Bind to 127.0.0.1 when using Cloudflare Tunnel or a local reverse proxy.
# Set API_BIND_IP=0.0.0.0 only when you intentionally expose the API on the host network.
API_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1
PROD_FRONTEND_PORT=8080
# PUBLIC_API_URL is embedded into the production frontend build.
# If this points to a public hostname, protect the frontend and API with
# Cloudflare Access, Tailscale/WireGuard/VPN, or future real login/session auth.
PUBLIC_API_URL=https://api.example.com

# Watchdog health check settings.
# PUBLIC_HEALTH_URL can be a public Cloudflare URL or a local host URL.
# WATCHDOG_SERVICES is a whitespace-separated list of production Compose services to recover.
# Default "api" does not start optional profiles. Use "api cloudflared" only for tunnel deployments.
PUBLIC_HEALTH_URL=http://127.0.0.1:8000/health/ready
WATCHDOG_SERVICES=api
WATCHDOG_RECHECK_WAIT_SECONDS=30
WATCHDOG_CURL_TIMEOUT_SECONDS=10

# Optional production Cloudflare Tunnel.
# Required only when starting docker-compose.prod.yml with --profile tunnel.
TUNNEL_TOKEN=
