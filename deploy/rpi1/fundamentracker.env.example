# Native Raspberry Pi 1 deployment.
# Installed as /etc/fundamentracker/fundamentracker.env by install-native.sh.
# Keep the installed file readable only by root and the fundamentracker group.

APP_ENV=production
LOG_LEVEL=INFO

DATABASE_BACKEND=sqlite
SQLITE_PATH=/srv/fundamentracker/fundamentracker.db

# Replace before starting the service.
API_AUTH_TOKEN=change-me-api-token
READONLY_PUBLIC=false
PUBLIC_READY_HEALTH=false

# The browser frontend remains on Vercel.
CORS_ALLOWED_ORIGINS=https://fundamentracker.vercel.app
ALLOW_WILDCARD_CORS=false

# Market-data cache defaults. Long-lived fundamental caches are helpful on the
# single-core Pi and avoid unnecessary upstream work.
MARKET_DATA_TTL_PRICE_SECONDS=300
MARKET_DATA_TTL_QUOTE_SECONDS=300
MARKET_DATA_TTL_FUNDAMENTALS_SECONDS=86400
MARKET_DATA_TTL_STATEMENTS_SECONDS=604800

# Optional integrations.
GEMINI_API_KEY=
SEC_USER_AGENT=FundamenTracker contact@example.com
SEC_RATE_LIMIT_SECONDS=0.2
SEC_TICKER_CACHE_PATH=/srv/fundamentracker/sec-tickers.json
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
